{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",

  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/offline.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/**/*.png",
          "/**/*.jpg",
          "/**/*.svg",
          "/**/*.webp"
        ]
      }
    }
  ],

  "dataGroups": [
    {
      "name": "rick-and-morty-api",
      "urls": [
        "https://rickandmortyapi.com/api/**"
      ],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "7d",
        "strategy": "freshness",
        "timeout": "5s"
      }
    }
  ]
}
